                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4096
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4096
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12582912
