                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^/home/v2/assets/[1-9][0-9]*/preview\\?variant=(grid|display)&revision=[1-9][0-9]*$"
                    }
                  },
                  "required": [
                    "state",
                    "width",
                    "height",
                    "bytes",
                    "sha256",
                    "url"
                  ]
                }
              ]
            }
          },
          "required": [
            "grid",
            "display"
          ]
        },
        "video": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "unavailable"
                },
                "reason": {
                  "enum": [
