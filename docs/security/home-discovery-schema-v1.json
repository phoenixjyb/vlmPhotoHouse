                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1920
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1920
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400000
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 34359738368
