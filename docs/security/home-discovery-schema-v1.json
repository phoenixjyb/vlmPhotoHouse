          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "has_more": {
          "type": "boolean"
        },
        "filter_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v2_asset"
          },
          "maxItems": 100
        }
      },
      "required": [
        "version",
        "revision",
        "catalog_revision",
        "library",
        "page",
        "page_size",
        "total",
        "has_more",
        "filter_fingerprint",
        "items"
      ]
    },
