{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "search_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "people": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true
                },
                "match": {
                  "enum": [
                    "any",
                    "all"
                  ]
                }
              },
              "required": [
                "ids",
                "match"
              ]
            },
            "date": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true
            },
            "media": {
              "type": "array",
              "items": {
                "enum": [
                  "photo",
                  "video",
                  "unsupported"
                ]
              },
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true
            },
            "tags": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true
                },
                "match": {
                  "enum": [
                    "any",
                    "all"
                  ]
                }
              },
              "required": [
                "ids",
                "match"
              ]
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": []
        }
      },
      "required": [
        "revision",
        "page",
        "page_size",
        "filters"
      ]
    },
    "facets_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "catalog_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "library": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            },
            "title": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "id",
            "title"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "has_more": {
          "type": "boolean"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "pinned_person_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "pinned_people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          },
          "maxItems": 32
        },
        "facet": {
          "enum": [
            "people",
            "tags",
            "locations"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/person"
              },
              {
                "$ref": "#/$defs/tag"
              },
              {
                "$ref": "#/$defs/location"
              }
            ]
          },
          "maxItems": 100
        }
      },
      "required": [
        "version",
        "revision",
        "catalog_revision",
        "library",
        "page",
        "page_size",
        "total",
        "has_more",
        "capabilities",
        "pinned_person_ids",
        "pinned_people",
        "facet",
        "items"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "facet": {
                "const": "people"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/person"
                },
                "maxItems": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "facet": {
                "const": "tags"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/tag"
                },
                "maxItems": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "facet": {
                "const": "locations"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/location"
                },
                "maxItems": 100
              }
            }
          }
        }
      ]
    },
    "search_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
